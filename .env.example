# Required: absolute path or ~/path to your Git-managed Obsidian vault.
VAULT_PATH=/absolute/path/to/your/vault

# Optional: relative Obsidian configuration directory inside the vault.
OBSIDIAN_CONFIG_DIR=.obsidian

# Optional: empty NODE_PATH uses the Node.js executable running the installer.
# Set absolute executable paths if Obsidian cannot find them through PATH.
NODE_PATH=
GIT_PATH=git

# Optional: {date} is replaced with the current ISO timestamp.
COMMIT_MESSAGE="vault: auto backup {date}"
